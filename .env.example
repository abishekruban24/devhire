# -----------------------------------------------------------------------------
# DevHire — Environment Variables Template
# -----------------------------------------------------------------------------
# Copy this file to .env or .env.local for local development.
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# -----------------------------------------------------------------------------

# PostgreSQL Connection Strings (Neon PostgreSQL)
# Pooled connection URL (used by Prisma Client in application runtime)
DATABASE_URL="postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection URL (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://user:password@ep-direct.region.aws.neon.tech/neondb?sslmode=require"

# Next.js Application Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Auth.js / NextAuth v5 Authentication Secret (generate with: openssl rand -base64 33)
AUTH_SECRET="devhire-placeholder-secret-change-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Upstash Redis (Distributed Rate Limiting for Serverless / Production)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# Future Assessment Code Execution Engine (Phase 3 Placeholder)
# CODE_EXECUTION_API_URL="http://localhost:8000"
# CODE_EXECUTION_API_KEY=""

