# -----------------------------------------------------------------------------
# DevHire — Environment Variables Template
# -----------------------------------------------------------------------------
# Copy this file to .env or .env.local for local development.
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# -----------------------------------------------------------------------------

# PostgreSQL Connection String (Phase 2 Database Integration)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example: postgresql://devhire_user:securepassword@localhost:5432/devhire_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devhire?schema=public"

# Next.js Application Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Authentication (Phase 2 Placeholder)
NEXTAUTH_SECRET="devhire-placeholder-secret-change-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Future Assessment Code Execution Engine (Phase 3 Placeholder)
# CODE_EXECUTION_API_URL="http://localhost:8000"
# CODE_EXECUTION_API_KEY=""
