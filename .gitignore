# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/.next/
/out/

# production
/build

# misc & certificates
.DS_Store
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (prevent secret leaks; allow .env.example)
.env
.env.local
.env.*.local
.env*.local
.env.development
.env.test
.env.production
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# editor / assistant skills
.agents/
.claude/
.windsurf/
skills-lock.json
