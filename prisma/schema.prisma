// DevHire Prisma Database Schema
// Smart Technical Recruitment and Coding Assessment Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobLocationType {
  REMOTE
  HYBRID
  ON_SITE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  SUBMITTED
  IN_REVIEW
  ASSESSMENT_INVITED
  ASSESSMENT_COMPLETED
  SHORTLISTED
  REJECTED
  OFFERED
}

enum AssessmentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  EXPIRED
}

enum EvaluationJobStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED_RETRYABLE
  FAILED_TERMINAL
}

enum InvitationStatus {
  PENDING
  STARTED
  COMPLETED
  EXPIRED
  REVOKED
}

enum ReviewStatus {
  DRAFT
  PUBLISHED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
}

enum SubmissionReason {
  MANUAL
  TIMER_EXPIRED
  POLICY_VIOLATION
}

enum IntegrityEventType {
  TAB_SWITCH
  FOCUS_LOSS
  FULLSCREEN_EXIT
  PASTE_ATTEMPT
  COPY_ATTEMPT
  FACE_ABSENT
  MULTIPLE_FACES
  CAMERA_DISCONNECTED
  CAMERA_BLOCKED
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   // Secure hashed password, never stored in plaintext
  name         String
  role         Role     @default(CANDIDATE)
  avatarUrl    String?
  headline     String?
  bio          String?  @db.Text
  resumeUrl    String?
  githubUrl    String?
  linkedinUrl  String?
  skills       String[] @default([])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdJobs              Job[]                  @relation("RecruiterJobs")
  createdAssessments       Assessment[]           @relation("RecruiterAssessments")
  applications             Application[]
  assessmentAttempts       AssessmentAttempt[]
  candidateInvitations     AssessmentInvitation[] @relation("CandidateInvitations")
  recruiterInvitationsSent AssessmentInvitation[] @relation("RecruiterInvitationsSent")
  submissions              Submission[]
  reviews                  AssessmentReview[]     @relation("RecruiterReviews")
  recordingAuditLogs       RecordingAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([companyId])
}

model Company {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  website     String?
  description String?  @db.Text
  industry    String?
  location    String?

  members     User[]
  jobs        Job[]
  assessments Assessment[]
  invitations AssessmentInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Job {
  id              String          @id @default(uuid())
  title           String
  slug            String
  description     String          @db.Text
  requirements    String          @db.Text
  location        String
  locationType    JobLocationType @default(REMOTE)
  type            JobType         @default(FULL_TIME)
  status          JobStatus       @default(DRAFT)
  salaryMin       Int?
  salaryMax       Int?
  currency        String          @default("USD")
  experienceLevel String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  recruiterId String
  recruiter   User   @relation("RecruiterJobs", fields: [recruiterId], references: [id], onDelete: Restrict)

  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([recruiterId])
  @@index([assessmentId])
  @@index([status])
  @@index([createdAt])
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(SUBMITTED)
  coverLetter String?           @db.Text
  resumeUrl   String?
  notes       String?           @db.Text

  assessmentAttempts AssessmentAttempt[]
  invitations        AssessmentInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([status])
}

model Assessment {
  id              String           @id @default(uuid())
  title           String
  description     String           @db.Text
  durationMinutes Int              @default(60)
  passingScore    Float            @default(70.0)
  status          AssessmentStatus @default(DRAFT)

  // Phase 9 Proctoring Configuration
  enableProctoring       Boolean          @default(false)
  requireFullscreen      Boolean          @default(false)
  trackTabSwitches       Boolean          @default(true)
  trackFocusLoss         Boolean          @default(true)
  restrictPaste          Boolean          @default(false)
  restrictCopy           Boolean          @default(false)
  maxViolations          Int              @default(3)
  autoSubmitOnViolations Boolean          @default(false)
  webcamProctoring       Boolean          @default(false)
  recordingMode          String           @default("NONE") // NONE, INCIDENT, FULL

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("RecruiterAssessments", fields: [creatorId], references: [id], onDelete: Restrict)

  jobs        Job[]
  questions   Question[]
  attempts    AssessmentAttempt[]
  invitations AssessmentInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([creatorId])
  @@index([status])
}

model Question {
  id             String             @id @default(uuid())
  assessmentId   String
  assessment     Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  title          String
  description    String             @db.Text
  difficulty     QuestionDifficulty @default(MEDIUM)
  points         Int                @default(100)
  timeLimitMs    Int                @default(2000)
  memoryLimitKb  Int                @default(262144)
  starterCode    Json?
  orderIndex     Int                @default(0)

  testCases       TestCase[]
  submissions     Submission[]
  questionReviews QuestionReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
  @@index([difficulty])
  @@index([orderIndex])
}

model TestCase {
  id             String  @id @default(uuid())
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  input          String  @db.Text
  expectedOutput String  @db.Text
  // Server-side only: hidden test cases are not revealed to candidate during live assessment
  isHidden       Boolean @default(false)
  explanation    String? @db.Text
  weight         Float   @default(1.0)

  submissionResults SubmissionResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
  @@index([isHidden])
}

model AssessmentAttempt {
  id            String                @id @default(uuid())
  assessmentId  String
  assessment    Assessment            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     User                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application?          @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  invitationId  String?
  invitation    AssessmentInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  status        AttemptStatus         @default(NOT_STARTED)
  score         Float?
  startedAt     DateTime?
  submittedAt   DateTime?
  expiresAt     DateTime?

  // Phase 9 Proctoring Snapshots & Integrity Records
  submissionReason      SubmissionReason @default(MANUAL)
  proctoringSnapshot    Json?
  consentGivenAt        DateTime?
  cameraConsentGiven    Boolean          @default(false)
  recordingConsentGiven Boolean          @default(false)
  accommodationGranted  Boolean          @default(false)
  accommodationNotes    String?          @db.Text
  violationCount        Int              @default(0)

  submissions     Submission[]
  evaluationJob   EvaluationJob?
  review          AssessmentReview?
  integrityEvents IntegrityEvent[]
  recordings      AssessmentRecording[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
  @@index([candidateId])
  @@index([applicationId])
  @@index([invitationId])
  @@index([status])
}

model Submission {
  id             String           @id @default(uuid())
  attemptId      String
  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      User             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  language       String
  code           String           @db.Text
  status         SubmissionStatus @default(PENDING)
  passedTestCases Int             @default(0)
  totalTestCases Int              @default(0)
  score          Float            @default(0.0)
  executionTimeMs Int?
  memoryUsedKb   Int?
  compileError   String?          @db.Text

  results SubmissionResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attemptId])
  @@index([questionId])
  @@index([candidateId])
  @@index([status])
}

model SubmissionResult {
  id              String     @id @default(uuid())
  submissionId    String
  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCaseId      String
  testCase        TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  passed          Boolean
  actualOutput    String?    @db.Text
  executionTimeMs Int?
  memoryUsedKb    Int?
  errorMessage    String?    @db.Text

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([testCaseId])
  @@index([passed])
}

model AssessmentInvitation {
  id            String           @id @default(uuid())
  assessmentId  String
  assessment    Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     User             @relation("CandidateInvitations", fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedById   String
  invitedBy     User             @relation("RecruiterInvitationsSent", fields: [invitedById], references: [id], onDelete: Restrict)
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  revokedAt     DateTime?

  attempts AssessmentAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([companyId])
  @@index([assessmentId])
  @@index([applicationId])
  @@index([status])
  @@index([expiresAt])
}

model EvaluationJob {
  id          String              @id @default(uuid())
  attemptId   String              @unique
  attempt     AssessmentAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  status      EvaluationJobStatus @default(QUEUED)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(3)
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?             @db.Text
  nextRunAt   DateTime            @default(now())
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, nextRunAt])
  @@index([lockedAt])
}

model AssessmentReview {
  id             String            @id @default(uuid())
  attemptId      String            @unique
  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User              @relation("RecruiterReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  status         ReviewStatus      @default(DRAFT)
  totalScore     Float             @default(0.0) // Percentage (0 - 100)
  totalPoints    Float             @default(0.0)
  pointsPossible Float             @default(0.0)
  passed         Boolean           @default(false)
  feedback       String?           @db.Text
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  questionReviews QuestionReview[]

  @@index([attemptId])
  @@index([reviewerId])
  @@index([status])
}

model QuestionReview {
  id             String           @id @default(uuid())
  reviewId       String
  review         AssessmentReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  pointsEarned   Float            @default(0.0)
  pointsPossible Float            @default(0.0)
  feedback       String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([reviewId, questionId])
  @@index([reviewId])
  @@index([questionId])
}

// -------------------------------------------------------------
// PHASE 9: ASSESSMENT INTEGRITY, PROCTORING & AUDIT MODELS
// -------------------------------------------------------------

model IntegrityEvent {
  id        String             @id @default(uuid())
  attemptId String
  attempt   AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  eventType IntegrityEventType
  severity  String             @default("WARNING") // INFO, WARNING, CRITICAL
  timestamp DateTime           @default(now())
  durationMs Int?              // Duration of unfocus/absence in milliseconds
  metadata  Json?              // Non-sensitive context (e.g. face count, window state)

  createdAt DateTime           @default(now())

  @@index([attemptId])
  @@index([eventType])
  @@index([timestamp])
}

model AssessmentRecording {
  id                 String            @id @default(uuid())
  attemptId          String
  attempt            AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  recordingType      String            @default("INCIDENT") // INCIDENT, FULL
  storageProvider    String            @default("LOCAL_DEV") // R2, SUPABASE, LOCAL_DEV, NONE
  storageKey         String            // Storage bucket object key or local path
  fileSize           Int               @default(0)
  mimeType           String            @default("video/webm")
  durationSeconds    Int               @default(0)
  incidentEventType  String?           // Event type that triggered incident clip
  status             String            @default("READY") // RECORDING, UPLOADING, READY, FAILED, DELETED
  expiresAt          DateTime          // Retention deadline (default 7 days)
  deletedAt          DateTime?

  createdAt          DateTime          @default(now())

  auditLogs          RecordingAuditLog[]

  @@index([attemptId])
  @@index([expiresAt])
  @@index([status])
}

model RecordingAuditLog {
  id          String              @id @default(uuid())
  recordingId String
  recording   AssessmentRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String              // PLAYBACK, DOWNLOAD, DELETE
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime            @default(now())

  @@index([recordingId])
  @@index([userId])
  @@index([timestamp])
}
